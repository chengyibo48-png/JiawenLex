# Browser-facing Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose these to NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=
# Optional fallback for existing projects that still use the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=
AI_KEY_ENCRYPTION_SECRET=
FILE_ACCESS_SECRET=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional local Node.js proxy. Leave blank on a hosted deployment.
# Example: http://127.0.0.1:7892 (use your own proxy port). Requires Node.js 24+.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
# SMTP used by daily reminders. Configure the same provider in Supabase Auth for verification/reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Independent S3-compatible private storage. Required before enabling destructive actions.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_SECRET=
# Supplemental application limits; provider billing caps must also be configured.
BACKUP_MAX_STORAGE_BYTES=8000000000
BACKUP_MAX_SNAPSHOT_BYTES=500000000
# B2 version accounting is automatic; set true for other versioned providers.
BACKUP_S3_VERSIONED=
# Direct PostgreSQL connection for the weekly backup worker, never NEXT_PUBLIC_*.
DATABASE_URL=
# Optional recovery drill settings. Use a separate disposable project.
SNAPSHOT_PREFIX=
RECOVERY_DUMP_PATH=
RECOVERY_DATABASE_URL=
RECOVERY_SUPABASE_URL=
RECOVERY_SUPABASE_SECRET_KEY=
RESTORE_CONFIRM=
# Local-only sample workspace. Must be false for a hosted deployment.
NEXT_PUBLIC_DEMO_MODE=true
